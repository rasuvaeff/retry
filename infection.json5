{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // ~96.6% overall with --with-uncovered (483 of 500 counted mutants killed, 5 of
    // them by timeout), which is the honest ceiling: every killable mutant is
    // killed. The 15 Escaped are genuine equivalents — psalm-required explicit
    // (float) casts in backoff/jitter, and (int) casts on the sub-millisecond
    // correction term of the elapsed-ms math and of RetryAfterParser (the only
    // deterministic test clock advances in whole milliseconds, so the microsecond
    // term coerces identically). Plus non-equivalent-but-unkillable survivors:
    // SystemSleeper::sleepMs's `$ms * 1000` -> `* 999`/`* 1001`
    // (IncrementInteger/DecrementInteger, Sleeper/SystemSleeper.php:19) — a 0.1%
    // perturbation of the requested wait, below any timing tolerance that stays
    // non-flaky against OS scheduler jitter; killing them would need a src/ seam
    // (an injectable sleep function). Also equivalent: SystemRandomizer::float()'s
    // `return $min` when min === max (Randomizer/SystemRandomizer.php:30) — the
    // fall-through getFloat(min, min, ClosedClosed) returns exactly min; and the
    // two NullSafeMethodCall mutants on RetryLog's `$this->logger?->warning/error`
    // (Log/RetryLog.php) — the best-effort catch (\Throwable) that guards a broken
    // logger also swallows the Error the mutant produces on a null logger, so the
    // behavior is identical by construction. The 2 Not Covered are the `throw new
    // \LogicException('Unreachable ...')` after the retry loops in Retry and
    // RetryingHttpClient: no input reaches them. Signature defaults are handled by
    // the template's ignore regex, which is why the static factories and with*()
    // methods declare one parameter per line.
    "minMsi": 95,
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `bool $strict = false,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable). Do NOT add ^ or $:
        // Infection wraps the pattern as ^-\s*REGEX$ over the removed diff line.
        // Verified 2026-11-01 by diffing the survivor lists with and without it:
        // bulkhead 6, circuit-breaker 13, json-ld 19 mutants removed, all of them
        // such signature lines; Escaped and Timed Out unchanged.
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false,
        // Off for the same reason: a ProtectedVisibility mutant on a protected method's
        // signature line is Not Covered and cannot be killed. Measured on
        // understudy-phpunit 2026-11-01: 4 of 4 such mutants were Not Covered.
        "ProtectedVisibility": false
    }
}
